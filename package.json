{
  "name": "dsh-dbhub-live",
  "version": "5.1.0",
  "description": "DSH 数据库 MCP 桥接插件：让 AI 直接查询 MySQL / PostgreSQL / MariaDB / SQLite / SQL Server。按工作区动态配置连接（可改名、可跨工作区复制），AI 自助配置管理，密码与连接串零知识（永不进入模型上下文），每次执行独立进程。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "doc/REQUIREMENTS.md",
    "doc/images",
    "test",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dbhub",
    "mcp",
    "database",
    "mysql",
    "postgres",
    "sqlite",
    "mariadb",
    "sqlserver",
    "plugin"
  ],
  "scripts": {
    "check": "node --check ./lib/index.mjs && node --check ./lib/bridge.mjs && node --check ./lib/config.mjs && node --check ./lib/state.mjs && node --check ./lib/options.mjs && node --check ./lib/runtime.mjs && node --check ./lib/mcp.mjs && node --check ./lib/adhoc.mjs && node --check ./lib/collect.mjs && node --check ./lib/tools.mjs && node --check ./lib/toml.mjs && node --check ./lib/capability.mjs && node --check ./lib/client.js",
    "test": "node --test test/",
    "check:ui": "node scripts/render-check.mjs",
    "check:secrets": "node scripts/desensitize-check.mjs",
    "prepublishOnly": "npm run check:secrets"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.6-alpha.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-mihu/dsh-dbhub-live.git"
  },
  "bugs": {
    "url": "https://github.com/mr-mihu/dsh-dbhub-live/issues"
  },
  "homepage": "https://github.com/mr-mihu/dsh-dbhub-live#readme",
  "license": "MIT"
}
