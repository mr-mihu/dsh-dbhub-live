{
  "name": "dsh-dbhub-live",
  "version": "4.0.0",
  "description": "DSH 数据库 MCP 桥接插件：零知识凭据管理（密码永不进模型）+ 按 source 的一次性进程执行（无常驻服务、天然并发与多实例安全）+ 自动安装 dbhub 与浏览器状态卡片。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "doc",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dbhub",
    "mcp",
    "database",
    "mysql",
    "postgres",
    "sqlite",
    "mariadb",
    "sqlserver",
    "plugin"
  ],
  "scripts": {
    "check": "node --check ./lib/index.mjs && node --check ./lib/config.mjs && node --check ./lib/state.mjs && node --check ./lib/options.mjs && node --check ./lib/runtime.mjs && node --check ./lib/mcp.mjs && node --check ./lib/adhoc.mjs && node --check ./lib/collect.mjs && node --check ./lib/tools.mjs && node --check ./lib/client.js",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-mihu/dsh-dbhub-live.git"
  },
  "bugs": {
    "url": "https://github.com/mr-mihu/dsh-dbhub-live/issues"
  },
  "homepage": "https://github.com/mr-mihu/dsh-dbhub-live#readme",
  "license": "MIT"
}
